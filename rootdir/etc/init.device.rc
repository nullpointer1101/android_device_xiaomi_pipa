on boot
    # WiFi country code
    setprop ro.boot.wificountrycode US

    chown system system /dev/xiaomi-touch
    chmod 0664 /dev/xiaomi-touch
    chown system system /dev/nanodev0
    chmod 0664 /dev/nanodev0

    # Bypass Charging permissions
    chown system system /sys/class/power_supply/battery/input_suspend
    chmod 0664 /sys/class/power_supply/battery/input_suspend

    # Thermal sconfig permissions
    chown system system /sys/class/thermal/thermal_message/sconfig
    chmod 0664 /sys/class/thermal/thermal_message/sconfig

    # Core Control (CPU online/offline nodes)
    chown system system /sys/devices/system/cpu/cpu1/online
    chmod 0664 /sys/devices/system/cpu/cpu1/online
    chown system system /sys/devices/system/cpu/cpu2/online
    chmod 0664 /sys/devices/system/cpu/cpu2/online
    chown system system /sys/devices/system/cpu/cpu3/online
    chmod 0664 /sys/devices/system/cpu/cpu3/online
    chown system system /sys/devices/system/cpu/cpu4/online
    chmod 0664 /sys/devices/system/cpu/cpu4/online
    chown system system /sys/devices/system/cpu/cpu5/online
    chmod 0664 /sys/devices/system/cpu/cpu5/online
    chown system system /sys/devices/system/cpu/cpu6/online
    chmod 0664 /sys/devices/system/cpu/cpu6/online
    chown system system /sys/devices/system/cpu/cpu7/online
    chmod 0664 /sys/devices/system/cpu/cpu7/online

    # Ensure schedutil governor is initialized across any kernel
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor schedutil
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_governor schedutil
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_governor schedutil

    # Schedutil rate limits (Thermal profile tuning)
    chown system system /sys/devices/system/cpu/cpufreq/policy0/schedutil/up_rate_limit_us
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/schedutil/up_rate_limit_us
    chown system system /sys/devices/system/cpu/cpufreq/policy0/schedutil/down_rate_limit_us
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/schedutil/down_rate_limit_us
    chown system system /sys/devices/system/cpu/cpufreq/policy4/schedutil/up_rate_limit_us
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy4/schedutil/up_rate_limit_us
    chown system system /sys/devices/system/cpu/cpufreq/policy4/schedutil/down_rate_limit_us
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy4/schedutil/down_rate_limit_us
    chown system system /sys/devices/system/cpu/cpufreq/policy7/schedutil/up_rate_limit_us
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy7/schedutil/up_rate_limit_us
    chown system system /sys/devices/system/cpu/cpufreq/policy7/schedutil/down_rate_limit_us
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy7/schedutil/down_rate_limit_us

    # CPU Frequency Scaling permissions
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq

    chown system system /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq

    chown system system /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq

    # GPU Frequency Scaling permissions
    chown system system /sys/class/kgsl/kgsl-3d0/max_gpuclk
    chmod 0664 /sys/class/kgsl/kgsl-3d0/max_gpuclk
    chown system system /sys/class/kgsl/kgsl-3d0/devfreq/max_freq
    chmod 0664 /sys/class/kgsl/kgsl-3d0/devfreq/max_freq

# Don't auto-start keyboard service
# it will be started via property trigger when user enables it in settings
service xiaomi-pen /vendor/bin/xiaomi-pen ${persist.vendor.parts.pen}
    class main
    user system
    group system input
    oneshot
    disabled

service xiaomi-keyboard /vendor/bin/xiaomi-keyboard
    class main
    user system
    group system input
    disabled


# Start keyboard service when user enables it
on property:persist.vendor.parts.keyboard=1
    start xiaomi-keyboard

# Stop keyboard service when user disables it
on property:persist.vendor.parts.keyboard=0
    stop xiaomi-keyboard

on property:persist.vendor.parts.pen=*
    start xiaomi-pen

# =========================================================================
# Dynamic Thermal & CPU/GPU Frequency Scaling Bridge (sys.pipacore.profile)
# Snapdragon 870 / pipa: 3 Modes (Performance: 10, Balanced: 0, Battery: 1)
# =========================================================================

# MODE 2: BALANCED / DEFAULT (sys.pipacore.profile = 0)
on property:sys.pipacore.profile=0
    # Enforce schedutil governor
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor schedutil
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_governor schedutil
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_governor schedutil
    # Little Cluster (CPU 0-3)
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq 300000
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq 1804800
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/up_rate_limit_us 1000
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/down_rate_limit_us 20000
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/hispeed_freq 1516800
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/hispeed_load 90
    # Big Cluster (CPU 4-6)
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq 710400
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq 2419200
    write /sys/devices/system/cpu/cpufreq/policy4/schedutil/up_rate_limit_us 1000
    write /sys/devices/system/cpu/cpufreq/policy4/schedutil/down_rate_limit_us 20000
    write /sys/devices/system/cpu/cpufreq/policy4/schedutil/hispeed_freq 1958400
    write /sys/devices/system/cpu/cpufreq/policy4/schedutil/hispeed_load 90
    # Prime Cluster (CPU 7)
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq 844800
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq 3187200
    write /sys/devices/system/cpu/cpufreq/policy7/schedutil/up_rate_limit_us 1000
    write /sys/devices/system/cpu/cpufreq/policy7/schedutil/down_rate_limit_us 20000
    write /sys/devices/system/cpu/cpufreq/policy7/schedutil/hispeed_freq 2419200
    write /sys/devices/system/cpu/cpufreq/policy7/schedutil/hispeed_load 95
    # GPU Default Scaling
    write /sys/class/kgsl/kgsl-3d0/max_gpuclk 670000000
    write /sys/class/kgsl/kgsl-3d0/devfreq/max_freq 670000000

# MODE 3: BATTERY SAVER (sys.pipacore.profile = 1)
on property:sys.pipacore.profile=1
    # Enforce schedutil governor
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor schedutil
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_governor schedutil
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_governor schedutil
    # Little Cluster (CPU 0-3) - lower min first, then cap max (1228800)
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq 300000
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq 1228800
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/up_rate_limit_us 5000
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/down_rate_limit_us 5000
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/hispeed_freq 1228800
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/hispeed_load 95
    # Big Cluster (CPU 4-6) - cap max to 1574400
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq 710400
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq 1574400
    write /sys/devices/system/cpu/cpufreq/policy4/schedutil/up_rate_limit_us 5000
    write /sys/devices/system/cpu/cpufreq/policy4/schedutil/down_rate_limit_us 5000
    write /sys/devices/system/cpu/cpufreq/policy4/schedutil/hispeed_freq 1478400
    write /sys/devices/system/cpu/cpufreq/policy4/schedutil/hispeed_load 95
    # Prime Cluster (CPU 7) - strictly capped to 1190400
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq 844800
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq 1190400
    write /sys/devices/system/cpu/cpufreq/policy7/schedutil/up_rate_limit_us 5000
    write /sys/devices/system/cpu/cpufreq/policy7/schedutil/down_rate_limit_us 5000
    write /sys/devices/system/cpu/cpufreq/policy7/schedutil/hispeed_freq 1190400
    write /sys/devices/system/cpu/cpufreq/policy7/schedutil/hispeed_load 95
    # GPU Cap for power saving
    write /sys/class/kgsl/kgsl-3d0/max_gpuclk 443000000
    write /sys/class/kgsl/kgsl-3d0/devfreq/max_freq 443000000

# MODE 1: PERFORMANCE (sys.pipacore.profile = 10)
on property:sys.pipacore.profile=10
    # Enforce schedutil governor
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor schedutil
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_governor schedutil
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_governor schedutil
    # Little Cluster (CPU 0-3) - uncap to max (1804800), raise min to 1075200
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq 1804800
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq 1075200
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/down_rate_limit_us 40000
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/hispeed_freq 1516800
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/hispeed_load 90
    # Big Cluster (CPU 4-6) - uncap to max (2419200), raise min to 1574400
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq 2419200
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq 1574400
    write /sys/devices/system/cpu/cpufreq/policy4/schedutil/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy4/schedutil/down_rate_limit_us 40000
    write /sys/devices/system/cpu/cpufreq/policy4/schedutil/hispeed_freq 1958400
    write /sys/devices/system/cpu/cpufreq/policy4/schedutil/hispeed_load 90
    # Prime Cluster (CPU 7) - uncap to max (3187200), raise min to 1766400
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq 3187200
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq 1766400
    write /sys/devices/system/cpu/cpufreq/policy7/schedutil/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy7/schedutil/down_rate_limit_us 40000
    write /sys/devices/system/cpu/cpufreq/policy7/schedutil/hispeed_freq 2419200
    write /sys/devices/system/cpu/cpufreq/policy7/schedutil/hispeed_load 95
    # GPU Uncapped Maximum
    write /sys/class/kgsl/kgsl-3d0/max_gpuclk 670000000
    write /sys/class/kgsl/kgsl-3d0/devfreq/max_freq 670000000
