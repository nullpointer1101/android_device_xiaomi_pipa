<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.pipacore"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.BIND_QUICK_SETTINGS_TILE" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <application
        android:label="@string/app_title"
        android:icon="@drawable/ic_settings_advanced"
        android:theme="@style/Theme.PipaCore.Dark"
        android:allowBackup="false"
        android:hasCode="true"
        android:defaultToDeviceProtectedStorage="true"
        android:directBootAware="true">

        <!-- Boot Completed Receiver -->
        <receiver
            android:name=".BootCompletedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- Main Dashboard Activity (Settings Integration) -->
        <activity
            android:name=".MainActivity"
            android:label="@string/dashboard_title"
            android:icon="@drawable/ic_settings_advanced"
            android:theme="@style/Theme.PipaCore.Dark"
            android:exported="true">

            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>

            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/dashboard_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/dashboard_subtitle" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_settings_advanced" />
        </activity>

        <!-- Core Control Activity -->
        <activity
            android:name=".CoreControlActivity"
            android:label="@string/core_control_title"
            android:icon="@drawable/ic_cpu"
            android:theme="@style/Theme.PipaCore.Dark"
            android:exported="false" />

        <!-- Thermal Profile Activity -->
        <activity
            android:name=".ThermalProfileActivity"
            android:label="@string/thermal_profile_title"
            android:icon="@drawable/ic_thermal_snowflake"
            android:theme="@style/Theme.PipaCore.Dark"
            android:exported="false" />

        <!-- Bypass Charging Activity -->
        <activity
            android:name=".BypassChargingActivity"
            android:label="@string/bypass_charging_title"
            android:icon="@drawable/ic_bolt"
            android:theme="@style/Theme.PipaCore.Dark"
            android:exported="false" />

        <!-- Stylus Activity -->
        <activity
            android:name=".StylusActivity"
            android:label="@string/stylus_title"
            android:icon="@drawable/ic_stylus"
            android:theme="@style/Theme.PipaCore.Dark"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Keyboard Activity -->
        <activity
            android:name=".KeyboardActivity"
            android:label="@string/keyboard_title"
            android:icon="@drawable/ic_keyboard"
            android:theme="@style/Theme.PipaCore.Dark"
            android:exported="false" />

        <!-- Lid Activity -->
        <activity
            android:name=".LidActivity"
            android:label="@string/lid_title"
            android:icon="@drawable/ic_lid"
            android:theme="@style/Theme.PipaCore.Dark"
            android:exported="false" />


        <!-- Thermal Profile QS Tile Service -->
        <service
            android:name=".ThermalProfileTileService"
            android:icon="@drawable/ic_thermal_snowflake"
            android:label="@string/thermal_profile_title"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- Bypass Charging QS Tile Service -->
        <service
            android:name=".BypassChargingTileService"
            android:icon="@drawable/ic_bolt"
            android:label="@string/bypass_charging_title"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
            <meta-data
                android:name="android.service.quicksettings.TILE_SERVICE_SETTINGS"
                android:value="org.pipacore.BypassChargingActivity" />
        </service>

    </application>
</manifest>
